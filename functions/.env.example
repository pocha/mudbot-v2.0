GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-flash-lite
EMBEDDING_MODEL_ID=gemini-embedding-001

# Realtime Database's regions are a much smaller set than Firestore's — this
# project's RTDB instance ended up in asia-southeast1, not co-located with
# Firestore/Functions in asia-south1. Confirm your own instance's real URL
# (Firebase console → Realtime Database) rather than assuming the default
# firebaseio.com form; the Admin SDK doesn't reliably fall back on its own.
RTDB_URL=https://your-project-default-rtdb.your-region.firebasedatabase.app

# Shared secret the VM orchestrator sends as the x-orchestrator-key header
# when calling mintContainerToken — generate a long random value, e.g.
# `openssl rand -hex 32`, and put the same value in the orchestrator's own
# environment once that exists. Not a real service-account identity yet
# (see the architecture writeup's "Still open" list).
ORCHESTRATOR_SHARED_KEY=
