# Same web app config as extension/src/firebaseConfig.ts / Firebase console →
# Project settings → Your apps. databaseURL matters here more than usual —
# Realtime Database's regions are a much smaller set than Firestore's, so this
# is very likely NOT the default https://<project>-default-rtdb.firebaseio.com
# form; copy the real URL from Firebase console → Realtime Database.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# The mintContainerToken Cloud Function's URL (see `firebase deploy` output,
# or `firebase functions:list`) and the shared secret it expects in the
# x-orchestrator-key header — must match functions/.env's
# ORCHESTRATOR_SHARED_KEY exactly.
MINT_TOKEN_URL=
ORCHESTRATOR_SHARED_KEY=

# The Docker image tag Executor/Creator run in — see ../container.
CONTAINER_IMAGE=mudbot-container:latest

# Passed through into every container's environment — same key functions/.env
# uses, or a per-user BYOK key once that exists. Kept here (not baked into the
# image) so it's one place to rotate.
GEMINI_API_KEY=

# For local/emulator testing (see README's "Local Testing"), don't edit this
# file — .env.local (already committed, no setup needed) is layered on top of
# it automatically when NODE_ENV=development, exactly like Cloud Functions'
# own .env.local convention. Only override a value there if your local setup
# genuinely differs from .env.local's defaults (a different project id, a
# non-Docker-Desktop host, etc).
