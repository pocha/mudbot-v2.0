# Committed on purpose — nothing here is a secret, just local topology.
# Loaded on top of .env (not instead of it) when NODE_ENV=development — see
# src/index.ts — so FIREBASE_API_KEY/ORCHESTRATOR_SHARED_KEY/GEMINI_API_KEY/etc
# still come from your real, gitignored .env. Only the fields that genuinely
# need a different value for local testing live here. A fresh clone +
# `npm install` + a real .env (see .env.example) + `npm start` just works,
# no extra copy-and-edit step for this file.

# The local Functions emulator's mintContainerToken endpoint, not the
# deployed one. Update the project id here if you're pointed at a different
# Firebase project than watobot-v2.
MINT_TOKEN_URL=http://127.0.0.1:5001/watobot-v2/asia-south1/mintContainerToken

# Where this orchestrator process (running on the host) reaches the
# emulators.
FIREBASE_EMULATOR_HOST=127.0.0.1
# Where the container (running inside Docker) reaches the same emulators —
# NOT 127.0.0.1/localhost, which inside a container means the container
# itself. host.docker.internal is Docker Desktop's (macOS/Windows) name for
# the host machine; on Linux Docker you may need a different value (or
# --add-host=host.docker.internal:host-gateway) — see README.
CONTAINER_FIREBASE_EMULATOR_HOST=host.docker.internal
