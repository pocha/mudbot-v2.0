{
  "rules": {
    "ingestQueue": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "commands": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "dispatchQueue": {
      ".read": "auth != null && auth.uid === 'orchestrator-service'",
      ".write": false
    }
  }
}
